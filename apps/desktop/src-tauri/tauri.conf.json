{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Xifeng",
    "version": "0.2.0",
    "identifier": "com.xifeng.app",
    "build": {
        "beforeDevCommand": "pnpm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "pnpm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "Xifeng",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "center": true,
                "decorations": false,
                "transparent": false,
                "shadow": true,
                "theme": "Light"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.ico"
        ],
        "resources": {
            "resources/core/": "core/"
        },
        "windows": {
            "nsis": {
                "installerHooks": "nsis/hooks.nsh"
            }
        }
    }
}